# ==============================================================================
# Beauty AI Orchestrator - Environment Variables (.env.example)
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-change-me-in-production-beauty-orchestrator
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Multi-Model LLM Orchestration Keys
# Stage 2: Reading & extracting prices/data from long Jina Reader Markdown texts
GOOGLE_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Agent 1B (Structured extraction of actives/texture), Conditional Routing & Findation
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_SMART_MODEL=gpt-4o

# Stage 4: Dermatological Guardrail & Final Curation
ANTHROPIC_API_KEY=your-anthropic-claude-api-key-here
ANTHROPIC_MODEL=claude-3-7-sonnet-latest

# Search & Scraping Tools
TAVILY_API_KEY=your-tavily-search-api-key-here
JINA_API_KEY=optional-jina-reader-api-key-for-higher-rate-limits
JINA_READER_BASE_URL=https://r.jina.ai/

# Background Automation (n8n Non-blocking Webhook)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/beauty-orchestrator
N8N_WEBHOOK_TIMEOUT_SECONDS=3.0
